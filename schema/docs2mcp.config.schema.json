{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suissa/docs2mcp/schema/docs2mcp.config.schema.json",
  "title": "docs2mcp configuration",
  "type": "object",
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri"
    },
    "system": {
      "enum": [
        "mintlify",
        "docsify",
        "hugo",
        "mkdocs",
        "docusaurus",
        "custom-html",
        "unknown"
      ]
    },
    "outputDir": {
      "type": "string",
      "default": "docs2mcp-generated"
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000,
      "default": 20000
    },
    "inspect": {
      "type": "boolean",
      "default": true
    },
    "runServer": {
      "type": "boolean",
      "default": false
    },
    "channels": {
      "type": "object",
      "properties": {
        "rest": {
          "type": "boolean",
          "default": true
        },
        "ws": {
          "type": "boolean",
          "default": true
        },
        "stdio": {
          "type": "boolean",
          "default": true
        },
        "mcpHttp": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8787
        }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "authEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
